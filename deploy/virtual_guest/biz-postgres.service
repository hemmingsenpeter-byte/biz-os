[Unit]
Description=BIZ OS virtual test appliance PostgreSQL 16
After=local-fs.target

[Service]
Type=simple
User=postgres
Group=postgres
RuntimeDirectory=biz-postgres
RuntimeDirectoryMode=0755
ExecStart=/opt/biz-os/.venv/lib/python3.12/site-packages/pgserver/pginstall/bin/postgres -D /var/lib/biz-os/postgres -k /run/biz-postgres -c listen_addresses=127.0.0.1 -c password_encryption=scram-sha-256
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGINT
TimeoutStopSec=60
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/biz-os/postgres /run/biz-postgres

[Install]
WantedBy=multi-user.target

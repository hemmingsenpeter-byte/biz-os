# Copy to deploy/.env. Never commit the real file.
POSTGRES_PASSWORD=change-me
# Random 32+ bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
BIZ_SECRET_KEY=change-me
# WebAuthn relying party: the hostname owners sign in on, and its full origin
BIZ_RP_ID=app.example.com
BIZ_ORIGIN=https://app.example.com
BIZ_DOMAIN=app.example.com
# Composition to load (path inside the container)
BIZ_APP_DIR=/app/apps/demo
# Model providers (Ollama is native on the host, no key needed)
ANTHROPIC_API_KEY=
# DocuSeal
DOCUSEAL_SECRET_KEY_BASE=change-me
DOCUSEAL_HOST=sign.example.com
# Cloudflare tunnel token (Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=
# Backups (restic to Backblaze B2 or Cloudflare R2, S3-compatible)
RESTIC_REPOSITORY=s3:https://<account>.r2.cloudflarestorage.com/biz-backups
RESTIC_PASSWORD=change-me
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For B2 native instead: RESTIC_REPOSITORY=b2:bucket:path, B2_ACCOUNT_ID=, B2_ACCOUNT_KEY=

# Local model (Ollama runs natively on macOS)
BIZ_OLLAMA_URL=http://host.docker.internal:11434
BIZ_OLLAMA_MODEL=
BIZ_OLLAMA_EMBED_MODEL=

# Twilio (missed-call text-back, SMS). WEBHOOK_URL is the full public URL Twilio calls,
# e.g. https://hooks.<your-domain>/v1/intake/telephony (via cloudflared).
BIZ_TWILIO_SID=
BIZ_TWILIO_TOKEN=
BIZ_TWILIO_FROM=
BIZ_TWILIO_WEBHOOK_URL=

# Microsoft 365 (mail + calendar) via an Entra app with client credentials
BIZ_M365_TENANT=
BIZ_M365_CLIENT_ID=
BIZ_M365_SECRET=
BIZ_M365_MAILBOX=
BIZ_M365_TZ=UTC

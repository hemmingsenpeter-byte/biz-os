# Private owner ingress. The host publishes this listener to loopback only, and
# Tailscale Serve terminates HTTPS subject to the tailnet ACL.
:8080 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /v1/voice_capture/upload {
		request_body {
			max_size 110MB
		}
		reverse_proxy biz-api:8000
	}

	handle /v1/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy biz-api:8000
	}

	handle {
		reverse_proxy biz-web:3000
	}
}

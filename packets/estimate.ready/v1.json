{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estimate.ready/v1",
  "type": "object",
  "required": [
    "estimate_id",
    "document_id",
    "total_minor",
    "currency"
  ],
  "properties": {
    "estimate_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "total_minor": {
      "type": "integer"
    },
    "currency": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

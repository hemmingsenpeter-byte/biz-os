{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "po.issued/v1",
  "type": "object",
  "required": [
    "po_id",
    "number",
    "supplier_party_id",
    "total_minor",
    "currency",
    "job_id"
  ],
  "properties": {
    "po_id": {
      "type": "string",
      "format": "uuid"
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "supplier_party_id": {
      "type": "string",
      "format": "uuid"
    },
    "total_minor": {
      "type": "integer"
    },
    "currency": {
      "type": "string"
    },
    "job_id": {
      "type": ["string", "null"],
      "format": "uuid"
    }
  }
}

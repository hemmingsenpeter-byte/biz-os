{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site.issue/v1",
  "type": "object",
  "required": [
    "issue_id",
    "site_id",
    "description"
  ],
  "properties": {
    "issue_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    }
  }
}

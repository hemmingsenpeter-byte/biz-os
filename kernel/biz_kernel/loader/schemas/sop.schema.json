{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biz/sop",
  "description": "SOP format. trigger = packet type that starts it. task = task record created for the run (kind drives evidence rules). Steps run in order, ids unique. Kinds: tool (call allow-listed tool; gated tools are staged and wait for approval), draft (model drafts from a prompt file relative to the role pack, structured by `schema`, no tools), approve (explicit approval with approver and reason), publish (publish a packet; payload and summary are templates). Optional `when` (SOP level: checked against the trigger packet; step level: skips the step, whose output becomes {skipped: true}) is '<template> ==|!=|in <value>[,<value>]'. A publish step may set `evidence` to also note that evidence kind. Templates: '{{a.b.c}}' over packet.* and steps.<id>.output; a string that is exactly one template yields the raw value.",
  "type": "object",
  "required": [
    "name",
    "trigger",
    "goal_key",
    "task",
    "steps"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "trigger": {
      "type": "string"
    },
    "goal_key": {
      "type": "string"
    },
    "when": {
      "type": "string"
    },
    "task": {
      "type": "object",
      "required": [
        "kind",
        "title"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "tool",
              "draft",
              "approve",
              "publish"
            ]
          },
          "tool": {
            "type": "string"
          },
          "args": {
            "type": "object"
          },
          "decision_type": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "schema": {
            "type": "object"
          },
          "inputs": {
            "type": "object"
          },
          "approver": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "packet": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "summary": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "tool"
                }
              }
            },
            "then": {
              "required": [
                "tool"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "draft"
                }
              }
            },
            "then": {
              "required": [
                "prompt"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "approve"
                }
              }
            },
            "then": {
              "required": [
                "approver",
                "reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "publish"
                }
              }
            },
            "then": {
              "required": [
                "packet",
                "payload"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

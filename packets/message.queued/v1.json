{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "message.queued/v1",
  "type": "object",
  "required": [
    "message_id",
    "channel",
    "to",
    "status"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "channel": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

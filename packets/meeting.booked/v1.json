{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meeting.booked/v1",
  "type": "object",
  "required": [
    "meeting_id",
    "party_id",
    "starts_at"
  ],
  "properties": {
    "meeting_id": {
      "type": "string",
      "format": "uuid"
    },
    "party_id": {
      "type": "string",
      "format": "uuid"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}

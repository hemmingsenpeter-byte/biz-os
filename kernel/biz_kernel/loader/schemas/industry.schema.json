{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "biz/industry",
  "type": "object",
  "required": [
    "industry",
    "version",
    "requires",
    "fills"
  ],
  "properties": {
    "industry": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "requires": {
      "type": "object",
      "properties": {
        "kernel": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ext_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fills": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}

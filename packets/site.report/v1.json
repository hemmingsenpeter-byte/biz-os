{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site.report/v1",
  "type": "object",
  "required": [
    "report_id",
    "site_id",
    "summary"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "summary": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

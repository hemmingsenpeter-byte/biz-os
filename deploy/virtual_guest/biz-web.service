[Unit]
Description=BIZ OS virtual test appliance owner console
Requires=biz-api.service
After=biz-api.service network.target

[Service]
Type=simple
User=biz
Group=biz
WorkingDirectory=/opt/biz-web
EnvironmentFile=/etc/biz-os/virtual.env
Environment=HOSTNAME=0.0.0.0 PORT=3000
ExecStart=/opt/biz-node/bin/node /opt/biz-web/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target

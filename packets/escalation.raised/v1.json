{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "escalation.raised/v1",
  "type": "object",
  "required": [
    "subject",
    "reason",
    "raised_by"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "raised_by": {
      "type": "string"
    },
    "packet_id": {
      "type": "string",
      "format": "uuid"
    }
  }
}
